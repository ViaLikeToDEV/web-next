    "/api/products/bulk": {
      "patch": {
        "tags": [
          "Products"
        ],
        "summary": "แก้ไขสต็อกหลายรายการ",
        "operationId": "updateProductStockBulk",
        "description": "อัปเดตแบบ transaction ทั้งหมดสำเร็จพร้อมกันหรือไม่บันทึกเลย; id ต้องไม่ซ้ำกัน และแต่ละคำขอมีได้ 1–100 รายการ",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "same"
                        ]
                      },
                      "ids": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "uniqueItems": true,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "example": 1
                        }
                      },
                      "stock": {
                        "type": "integer",
                        "minimum": 0,
                        "example": 10
                      }
                    },
                    "required": [
                      "mode",
                      "ids",
                      "stock"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "different"
                        ]
                      },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "$ref": "#/components/schemas/StockUpdate"
                        }
                      }
                    },
                    "required": [
                      "mode",
                      "items"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "แก้ไขสำเร็จ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updated": {
                      "type": "integer",
                      "example": 2
                    }
                  },
                  "required": [
